# Copy to .env and fill in the placeholders. `.env` is git-ignored.
#   cp .env.example .env
# Both scripts/kc_import.sh and the Makefile auto-load .env from the repo root.
# To use plain `dbt` commands, load it first:  set -a; source .env; set +a

# ----------------------------------------------------------------------------
# dbt / BigQuery (read by profiles.yml)
# ----------------------------------------------------------------------------
# GCP project that will contain the sources / landing / raw / curated / conformed datasets.
DBT_GCP_PROJECT=YOUR_GCP_PROJECT_ID
# BigQuery location for dataset creation. Keep identical to KC_LOCATION.
DBT_BQ_LOCATION=us-central1
# Fallback dataset for nodes without an explicit +schema (normally unused).
DBT_DEFAULT_DATASET=dbt_bq_demo

# ----------------------------------------------------------------------------
# Knowledge Catalog import (read by scripts/kc_import.sh)
# https://docs.cloud.google.com/knowledge-catalog/docs/dbt-transfer
# ----------------------------------------------------------------------------
# Project that owns the entry group / metadata job. Usually the same project.
KC_PROJECT_ID=YOUR_GCP_PROJECT_ID
# Region of the entry group. Must be a region (not a multi-region) and should
# match DBT_BQ_LOCATION so dbt model -> BigQuery table links resolve.
KC_LOCATION=us-central1
# Entry group that receives the dbt entries (created by `kc_import.sh setup`).
KC_ENTRY_GROUP=dbt-metadata-ingestion
# Output/staging bucket (name only, no gs://). The transformed
# dbt_metadata.jsonl is uploaded here and read by the Knowledge Catalog service agent.
KC_STAGING_BUCKET=YOUR_STAGING_BUCKET_NAME
# Object prefix inside the staging bucket.
KC_STAGING_PREFIX=dbt-imports
# Set to "true" if the BigQuery tables are NOT cataloged in Knowledge Catalog
# (adds --skip-bigquery-link).
KC_SKIP_BIGQUERY_LINK=false
# Have `setup` also enable the Data Lineage API (datalineage.googleapis.com) in both
# projects so BigQuery records native table-level lineage for the dbt jobs. Lineage is
# a billable Dataplex feature (negligible at this scale); set false to opt out.
ENABLE_DATA_LINEAGE=true

# ----------------------------------------------------------------------------
# Identity
# ----------------------------------------------------------------------------
# gcloud account the scripts must use. Exported as CLOUDSDK_CORE_ACCOUNT for
# every gcloud call, and the scripts refuse to run if this account is not
# authenticated (gcloud auth login ACCOUNT). In Cloud Shell this is the user
# you opened Cloud Shell as. Leave unset to use whatever gcloud has active.
GCLOUD_ACCOUNT=YOUR_GCP_ACCOUNT_EMAIL
# Principal to grant caller IAM roles to via `kc_import.sh iam` (optional,
# not needed when the account is already Owner on the projects).
# e.g. user:you@example.com  or  serviceAccount:ci@PROJECT.iam.gserviceaccount.com
# KC_PRINCIPAL=user:you@example.com

